{
  "title": "Fraud Engine",
  "uid": "fraud-engine-v1",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_requests_total[1m]))",
          "legendFormat": "total req/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "title": "Deny Rate (% of processed requests)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_decisions_total{decision=\"deny\"}[1m])) / sum(rate(fraud_decisions_total[1m])) * 100",
          "legendFormat": "deny %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Idempotency Hit Rate (% of total requests)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(fraud_idempotency_hits_total[1m]) / rate(fraud_requests_total[1m]) * 100",
          "legendFormat": "cache hit %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Requests by Country",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "topk(15, sum by (country) (rate(fraud_country_requests_total[5m])))",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 5,
      "title": "Deny Rate by Rule (%)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (phase, rule) (rate(fraud_rule_denials_total[1m])) / scalar(sum(rate(fraud_decisions_total[1m]))) * 100",
          "legendFormat": "{{phase}}: {{rule}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 6,
      "title": "End-to-End Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(fraud_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(fraud_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, rate(fraud_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "title": "Step Latency Breakdown (p95)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(fraud_step_duration_seconds_bucket{step=\"feature_extraction\"}[5m]))",
          "legendFormat": "feature extraction"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(fraud_step_duration_seconds_bucket{step=\"model_inference\"}[5m]))",
          "legendFormat": "model inference"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(fraud_step_duration_seconds_bucket{step=\"db_write\"}[5m]))",
          "legendFormat": "db write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 8,
      "title": "Model Score Distribution",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(fraud_model_score_value_bucket[5m]))",
          "legendFormat": "median score"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(fraud_model_score_value_bucket[5m]))",
          "legendFormat": "p95 score"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 9,
      "title": "Requests per Worker (req/sec)",
      "description": "One line per uvicorn worker (label = process id). Uneven lines mean keep-alive connections are piling onto some workers.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (worker) (rate(fraud_worker_requests_total[1m]))",
          "legendFormat": "pid {{worker}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Decisions and model",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "title": "Decision mix: allow / review / deny (% of decisions)",
      "type": "timeseries",
      "description": "What the engine told callers. review = step up or manual look; deny = decline.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (decision) (rate(fraud_decisions_total[1m])) / scalar(sum(rate(fraud_decisions_total[1m]))) * 100",
          "legendFormat": "{{decision}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          },
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Review rate and model-deny rate (%)",
      "type": "timeseries",
      "description": "Share of decisions made by the model's two score bands. Expected on Fraud_Data after the 42-feature model ships: review about 6-7%, model deny about 0%.",
      "gridPos": {
        "x": 8,
        "y": 36,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_decision_rule_total{decision_rule=\"model_score_review\"}[1m])) / scalar(sum(rate(fraud_decisions_total[1m]))) * 100",
          "legendFormat": "review (model)"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_decision_rule_total{decision_rule=\"model_score_threshold\"}[1m])) / scalar(sum(rate(fraud_decisions_total[1m]))) * 100",
          "legendFormat": "deny (model)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Decisions by rule (per second)",
      "type": "timeseries",
      "description": "Which rule or score band produced each non-allow decision (audit decision_rule).",
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (decision_rule, decision) (rate(fraud_decision_rule_total{decision_rule!=\"none\"}[1m]))",
          "legendFormat": "{{decision_rule}} -> {{decision}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Model score (p50 / p95) against the served thresholds",
      "type": "timeseries",
      "description": "Scores are not probabilities (class weighting inflates them); read them against the thresholds. A drifting p50 with fixed thresholds changes the review rate.",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fraud_model_score_value_bucket[5m])))",
          "legendFormat": "score p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_model_score_value_bucket[5m])))",
          "legendFormat": "score p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "max(fraud_model_threshold{band=\"review\"})",
          "legendFormat": "review threshold"
        },
        {
          "datasource": "Prometheus",
          "expr": "max(fraud_model_threshold{band=\"deny\"})",
          "legendFormat": "deny threshold"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Shared devices: share of traffic and their decisions (%)",
      "type": "timeseries",
      "description": "did_other_uid_all > 0 (another account used this device before) is the model's strongest feature (about 5% of traffic, 23% fraud in training data). A jump in the share is the first drift signal to check.",
      "gridPos": {
        "x": 8,
        "y": 43,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_shared_device_total[1m])) / scalar(sum(rate(fraud_decisions_total[1m]))) * 100",
          "legendFormat": "shared-device share"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_shared_device_total{decision=\"review\"}[1m])) / sum(rate(fraud_shared_device_total[1m])) * 100",
          "legendFormat": "of those: reviewed"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(fraud_shared_device_total{decision=\"deny\"}[1m])) / sum(rate(fraud_shared_device_total[1m])) * 100",
          "legendFormat": "of those: denied"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Shadow rules: would-deny hits (per second)",
      "type": "timeseries",
      "description": "Rate-limiter branches running in shadow mode: counted, never applied.",
      "gridPos": {
        "x": 16,
        "y": 43,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (rule) (rate(fraud_rule_shadow_total[1m]))",
          "legendFormat": "{{rule}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Health and drift",
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "table",
      "title": "Alerts firing or pending",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 8,
        "h": 7
      },
      "description": "Straight from Prometheus (the ALERTS series), so it works without Grafana-managed alerting. Rules: prometheus/rules/fraud_engine.yml. What each one means and what to check first: docs/monitoring.md. Empty = nothing is wrong.",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "ALERTS{alertstate=~\"firing|pending\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Dependencies (1 = reachable)",
      "gridPos": {
        "x": 8,
        "y": 51,
        "w": 4,
        "h": 7
      },
      "description": "Each API worker probes Postgres and Redis every 10 s; this is the worst live worker.",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "min by (dependency) (fraud_dependency_up)",
          "legendFormat": "{{dependency}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 23,
      "title": "Error rate and 409 conflicts (% of requests)",
      "type": "timeseries",
      "description": "Alerts: FraudHighErrorRate above 1%, FraudIdempotencyConflicts above 2%.",
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:error_ratio:rate5m * 100",
          "legendFormat": "unhandled errors"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:conflict_ratio:rate10m * 100",
          "legendFormat": "idempotency conflicts (409)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "title": "Features answered by Postgres instead of Redis (% of requests)",
      "type": "timeseries",
      "description": "Normal for first-seen users and devices. A jump on known traffic means Redis lost data (see also the Redis keys panel).",
      "gridPos": {
        "x": 18,
        "y": 51,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:fallback_ratio:rate10m * 100",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "title": "Score drift (PSI vs validation-time distribution)",
      "type": "timeseries",
      "description": "Population Stability Index of the model score over the last hour against the ten validation-time deciles. 0 = same distribution.",
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:drift_psi:rate1h{feature=\"model_score\"}",
          "legendFormat": "score PSI (1 h window)"
        },
        {
          "datasource": "Prometheus",
          "expr": "vector(0.10)",
          "legendFormat": "watch (0.10)"
        },
        {
          "datasource": "Prometheus",
          "expr": "vector(0.25)",
          "legendFormat": "act (0.25)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 26,
      "title": "Feature drift (PSI per monitored model input)",
      "type": "timeseries",
      "description": "A drifting input with a steady score means the model is not using that range; a drifting input AND score needs a look at the feature pipeline first.",
      "gridPos": {
        "x": 8,
        "y": 58,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:drift_psi:rate1h{feature!=\"model_score\"}",
          "legendFormat": "{{feature}}"
        },
        {
          "datasource": "Prometheus",
          "expr": "vector(0.25)",
          "legendFormat": "act (0.25)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 27,
      "title": "Review rate: live vs expected at training time (%)",
      "type": "timeseries",
      "description": "Alerts fire when live is more than 2x or less than half of expected, with enough traffic.",
      "gridPos": {
        "x": 16,
        "y": 58,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:decision_share:rate30m{decision=\"review\"} * 100",
          "legendFormat": "live (30 min)"
        },
        {
          "datasource": "Prometheus",
          "expr": "max(fraud_expected_rate{kind=\"review_rate\"}) * 100",
          "legendFormat": "expected"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:shared_device_share:rate1h * 100",
          "legendFormat": "shared-device share (1 h)"
        },
        {
          "datasource": "Prometheus",
          "expr": "max(fraud_expected_rate{kind=\"shared_device_share\"}) * 100",
          "legendFormat": "expected shared-device share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 28,
      "title": "Live score-bucket shares (each expected at 10%)",
      "type": "timeseries",
      "description": "The ten buckets are the validation-time deciles of the score, so on unchanged traffic every line sits at 10%.",
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:drift_live_share:rate1h{feature=\"model_score\"} * 100",
          "legendFormat": "decile {{bucket}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 29,
      "title": "Redis keys",
      "type": "timeseries",
      "description": "All velocity state lives in Redis. FraudRedisDataLoss fires when this halves within an hour.",
      "gridPos": {
        "x": 12,
        "y": 65,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud_redis_keys",
          "legendFormat": "keys"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "title": "Latency p50 / p99 (recorded)",
      "type": "timeseries",
      "description": "FraudLatencyP99High fires above 250 ms for 10 minutes.",
      "gridPos": {
        "x": 18,
        "y": 65,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:latency_p50:rate5m",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:latency_p99:rate5m",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Golden signals: latency, traffic, errors, saturation",
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "title": "1. Latency (p50 / p99)",
      "type": "timeseries",
      "description": "How long a decision takes. Alerts: FraudLatencyP99High above 250 ms, FraudLatencyP50High above 100 ms.",
      "gridPos": {
        "x": 0,
        "y": 73,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:latency_p50:rate5m",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:latency_p99:rate5m",
          "legendFormat": "p99"
        },
        {
          "datasource": "Prometheus",
          "expr": "vector(0.25)",
          "legendFormat": "p99 alert (250 ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 42,
      "title": "2. Traffic (requests/s) against its 1-day average",
      "type": "timeseries",
      "description": "How much is being asked. Alerts: FraudTrafficSurge above 3x the average, FraudTrafficDrop below 30%, FraudNoTraffic.",
      "gridPos": {
        "x": 6,
        "y": 73,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:requests:rate5m",
          "legendFormat": "now (5 min rate)"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:requests:avg1d",
          "legendFormat": "1-day average"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(fraud_inflight_requests)",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 43,
      "title": "3. Errors (% of responses)",
      "type": "timeseries",
      "description": "How often it fails, and whose fault. Alerts: FraudHighErrorRate above 1%, FraudClientErrorRate above 5%, FraudIdempotencyConflicts above 2%.",
      "gridPos": {
        "x": 12,
        "y": 73,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:http_status_share:rate5m{status=~\"5..\"} * 100",
          "legendFormat": "our errors (5xx)"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:http_status_share:rate5m{status=\"422\"} * 100",
          "legendFormat": "invalid requests (422)"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:http_status_share:rate5m{status=\"409\"} * 100",
          "legendFormat": "duplicates in flight (409)"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:error_ratio:rate5m * 100",
          "legendFormat": "unhandled errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 44,
      "title": "4. Saturation (% of capacity)",
      "type": "timeseries",
      "description": "How full each thing that can run out is. Alerts at 80-85%. Redis memory shows nothing when no limit is configured.",
      "gridPos": {
        "x": 18,
        "y": 73,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:worker_cpu_utilization:avg * 100",
          "legendFormat": "worker CPU (avg)"
        },
        {
          "datasource": "Prometheus",
          "expr": "max(fraud_worker_cpu_utilization) * 100",
          "legendFormat": "worker CPU (busiest)"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:db_pool_utilization * 100",
          "legendFormat": "Postgres pool in use"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:postgres_connection_utilization * 100",
          "legendFormat": "Postgres connections / max"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:redis_memory_utilization * 100",
          "legendFormat": "Redis memory / limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 45,
      "title": "Event-loop lag (worst worker)",
      "type": "timeseries",
      "description": "Each worker serves all its requests on one thread. Lag is how late a 0.5 s timer fires: the earliest sign of an overloaded worker, before latency percentiles move.",
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "max(fraud_event_loop_lag_seconds)",
          "legendFormat": "lag"
        },
        {
          "datasource": "Prometheus",
          "expr": "vector(0.1)",
          "legendFormat": "alert (100 ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 46,
      "title": "Worker memory",
      "type": "timeseries",
      "description": "Resident memory per worker. No alert (no limit is configured); a steady climb is a leak.",
      "gridPos": {
        "x": 8,
        "y": 80,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud_worker_memory_bytes",
          "legendFormat": "worker {{pid}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 47,
      "title": "Action rates against their 1-day normal (%)",
      "type": "timeseries",
      "description": "What the engine tells callers to do. With no labels on live traffic this is the proxy for decision quality. Alerts: FraudAllowRateDrop, FraudReviewRateHigh / Low, FraudDenyRateHigh.",
      "gridPos": {
        "x": 16,
        "y": 80,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fraud:decision_share:rate5m * 100",
          "legendFormat": "{{decision}} now"
        },
        {
          "datasource": "Prometheus",
          "expr": "fraud:decision_share:avg1d * 100",
          "legendFormat": "{{decision}} 1-day avg"
        },
        {
          "datasource": "Prometheus",
          "expr": "max(fraud_expected_rate{kind=\"review_rate\"}) * 100",
          "legendFormat": "review expected at training time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
